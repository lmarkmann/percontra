# datasets stay out of the public repo; only the placement doc is tracked
data/*
!data/README.md

# python
.env
.env.*
__pycache__/
*.pyc
.venv/

# local database
*.duckdb
*.duckdb.wal

# web build artifacts (web/.gitignore covers the template's own set too)
web/dist/
web/node_modules/

# edge worker
edge/node_modules/
edge/.wrangler/

# Klim test fonts: licence forbids redistribution, keep local only (ADR 042)
web/src/fonts/*.woff2

# lm-ui polish and spatial captures: the reports commit, the images do not
docs/frontend/proof/
