{
	"name": "percontra-web",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"routes:gen": "tsr generate",
		"cf-typegen": "wrangler types --strict-vars=false",
		"build": "pnpm cf-typegen && pnpm routes:gen && tsc -b tsconfig.json server/tsconfig.json && vite build",
		"typecheck": "pnpm cf-typegen && pnpm routes:gen && tsc -b tsconfig.json server/tsconfig.json --noEmit",
		"check": "oxfmt --write . && oxlint --fix",
		"lint": "oxfmt --check . && oxlint",
		"lint:github": "oxlint --format=github",
		"format": "oxfmt --write .",
		"format:check": "oxfmt --check .",
		"test": "vitest",
		"test:run": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"knip": "knip",
		"type-spec-gate": "node scripts/type-spec-gate.ts",
		"size": "size-limit",
		"perf:ci": "lhci autorun",
		"ci:local": "pnpm typecheck && pnpm lint && pnpm knip && pnpm audit --prod --audit-level high && pnpm test:coverage && pnpm build && pnpm size && pnpm perf:ci && pnpm test:e2e",
		"preview": "vite preview",
		"deploy:cf": "pnpm build && wrangler deploy"
	},
	"dependencies": {
		"@base-ui/react": "^1.7.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@t3-oss/env-core": "^0.13.11",
		"@tanstack/react-query": "^5.102.8",
		"@tanstack/react-router": "^1.170.32",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"hono": "^4.13.5",
		"jose": "^6.2.10",
		"lucide-react": "^1.39.0",
		"motion": "^13.2.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"sonner": "^2.0.8",
		"tailwind-merge": "^3.6.0",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.5.4"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.54.3",
		"@lhci/cli": "0.15.1",
		"@playwright/test": "^1.62.1",
		"@size-limit/file": "^13.0.3",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/router-cli": "^1.167.33",
		"@tanstack/router-plugin": "^1.168.35",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.7",
		"@types/node": "^24.13.3",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.5",
		"@vitejs/plugin-react": "^6.1.1",
		"@vitest/coverage-v8": "4.1.11",
		"fake-indexeddb": "^6.2.5",
		"git-cliff": "2.13.1",
		"happy-dom": "^20.13.2",
		"knip": "^6.34.0",
		"msw": "^2.15.0",
		"oxfmt": "^0.66.0",
		"oxlint": "^1.81.0",
		"oxlint-tsgolint": "^7.0.2001",
		"rollup-plugin-visualizer": "^7.1.1",
		"shadcn": "^4.20.1",
		"size-limit": "^13.0.3",
		"tailwindcss": "^4.3.3",
		"typescript": "~7.0.2",
		"vite": "^8.2.2",
		"vitest": "4.1.11",
		"wrangler": "^4.128.0"
	},
	"size-limit": [
		{
			"name": "js (home boot aggregate)",
			"path": [
				"dist/client/assets/*.js",
				"!dist/client/assets/MotionConfig-*.js",
				"!dist/client/assets/_-*.js",
				"!dist/client/assets/_optional-seam_*.js",
				"!dist/client/assets/showcase-*.js",
				"!dist/client/assets/showcase-section-*.js",
				"!dist/client/assets/login-*.js",
				"!dist/client/assets/dashboard-*.js",
				"!dist/client/assets/not-found-*.js",
				"!dist/client/assets/motion-shell-*.js",
				"!dist/client/assets/motion-*.js",
				"!dist/client/assets/loader-circle-*.js",
				"!dist/client/assets/copy-button-*.js",
				"!dist/client/assets/dist-*.js",
				"!dist/client/assets/empty-*.js",
				"!dist/client/assets/icon-swap-*.js",
				"!dist/client/assets/input-*.js",
				"!dist/client/assets/routes-*.js",
				"!dist/client/assets/shadowDom-*.js",
				"!dist/client/assets/skeleton-*.js",
				"!dist/client/assets/theme-toggle-lean-*.js",
				"!dist/client/assets/workos-login-button-*.js",
				"!dist/client/assets/posthog*.js",
				"!dist/client/assets/auth-*.js",
				"!dist/client/assets/authkit-*.js",
				"!dist/client/assets/sonner-*.js",
				"!dist/client/assets/toaster-*.js"
			],
			"limit": "200 kB"
		},
		{
			"name": "js (showcase)",
			"path": "dist/client/assets/showcase-*.js",
			"limit": "80 kB"
		},
		{
			"name": "js (motion)",
			"path": "dist/client/assets/motion-shell-*.js",
			"limit": "32 kB"
		},
		{
			"name": "css",
			"path": "dist/client/assets/*.css",
			"limit": "64 kB"
		}
	],
	"engines": {
		"node": ">=24.18.0"
	},
	"packageManager": "pnpm@11.24.0",
	"knip": {
		"entry": [
			"src/router.tsx"
		],
		"ignore": [
			"src/components/ui/**",
			"src/types/vendor-seams.d.ts",
			"src/critical.css",
			"lighthouserc.cjs"
		],
		"ignoreDependencies": [
			"posthog-js",
			"@sentry/react",
			"@workos-inc/authkit-react",
			"@fontsource-variable/inter",
			"git-cliff"
		]
	}
}
