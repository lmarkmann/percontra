# Command layer. Each recipe is the single source for one action in package.json;
# humans and the prek hooks (prek.toml) both call these. Just runs, prek orchestrates.

set shell := ["bash", "-c"]

_default:
	@just --list --unsorted

# dev server (cloudflare workerd via vite)
dev:
	pnpm dev

# oxfmt + oxlint: write/fix
check:
	pnpm check

# oxfmt write (prek oxfmt hook). Does not run oxlint --fix.
format:
	pnpm format

# oxfmt + oxlint: read-only (prek oxlint hook, CI)
lint:
	pnpm lint

# every font family is justified in the type spec
# (prek commit hook, scoped to font/style/spec changes)
type-spec-gate:
	pnpm type-spec-gate

# typecheck | run | watch
typecheck:
	pnpm typecheck
typerun:
	pnpm exec tsc -b tsconfig.json server/tsconfig.json --noEmit
typewatch:
	pnpm exec tsc -b tsconfig.json server/tsconfig.json --noEmit --watch

# route tree + worker types
gen:
	pnpm routes:gen
cfgen:
	pnpm cf-typegen

# vitest single run | watch | coverage (coverage is the prek coverage standard)
test:
	pnpm exec vitest run
testw:
	pnpm exec vitest
coverage:
	pnpm test:coverage

# Playwright end-to-end
e2e:
	pnpm test:e2e

# production build (typecheck + vite build) | build + deploy
build:
	pnpm build
deploy:
	pnpm deploy:cf

# full local CI gate: types, lint, knip, audit, coverage, build, size, perf, e2e
verify:
	pnpm ci:local

# single-release size/knip checks
size:
	pnpm size
knip:
	pnpm knip

# Releases are cut from the repo root: just changeset, just release.
