# Command layer. Each recipe is the single source for one action in package.json;
# humans and the prek hooks (prek.toml) both call these. Just runs, prek orchestrates.

set shell := ["bash", "-c"]

# The changelog starts after this tag. Everything before it is recorded in
# docs/synthesis/ and is deliberately not backfilled.
changelog_baseline := "v0.0.0"

_default:
	@just --list --unsorted

# dev server (cloudflare workerd via vite)
dev:
	pnpm dev

# oxfmt + oxlint: write/fix
check:
	pnpm check

# oxfmt write (prek oxfmt hook). Does not run oxlint --fix.
format:
	pnpm format

# oxfmt + oxlint: read-only (prek oxlint hook, CI)
lint:
	pnpm lint

# every font family is justified in the type spec
# (prek commit hook, scoped to font/style/spec changes)
type-spec-gate:
	pnpm type-spec-gate

# typecheck | run | watch
typecheck:
	pnpm typecheck
typerun:
	pnpm exec tsc -b tsconfig.json server/tsconfig.json --noEmit
typewatch:
	pnpm exec tsc -b tsconfig.json server/tsconfig.json --noEmit --watch

# route tree + worker types
gen:
	pnpm routes:gen
cfgen:
	pnpm cf-typegen

# vitest single run | watch | coverage (coverage is the prek coverage standard)
test:
	pnpm exec vitest run
testw:
	pnpm exec vitest
coverage:
	pnpm test:coverage

# Playwright end-to-end
e2e:
	pnpm test:e2e

# production build (typecheck + vite build) | build + deploy
build:
	pnpm build
deploy:
	pnpm deploy:cf

# full local CI gate: types, lint, knip, audit, coverage, build, size, perf, e2e
verify:
	pnpm ci:local

# single-release size/knip checks
size:
	pnpm size
knip:
	pnpm knip

# regenerate docs/CHANGELOG.md from the version tags (git-cliff)
# oxfmt owns the file's whitespace, so normalize what git-cliff wrote.
changelog:
	pnpm exec git-cliff {{changelog_baseline}}.. --output docs/CHANGELOG.md
	pnpm exec oxfmt --write docs/CHANGELOG.md

# what the next release would say, printed rather than written
unreleased:
	pnpm exec git-cliff {{changelog_baseline}}.. --unreleased --bump

# The headline becomes the tag message and the sentence after the date in the heading.
# cut VERSION with HEADLINE: write the section, commit it, tag it. Pushing stays manual.
release version headline:
	git diff --cached --quiet || { echo 'staged changes present; commit or reset them first'; exit 1; }
	pnpm pkg set version={{version}}
	pnpm exec git-cliff {{changelog_baseline}}.. --tag v{{version}} --with-tag-message "{{headline}}" --output docs/CHANGELOG.md
	pnpm exec oxfmt --write docs/CHANGELOG.md
	git add package.json docs/CHANGELOG.md
	git commit -m "chore(release): v{{version}}"
	git tag -a v{{version}} -m "{{headline}}"
	@echo 'tagged v{{version}}. Push it with: git push --follow-tags'
