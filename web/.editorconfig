# Editors, and files oxfmt does not format. oxfmt still owns JS/TS quotes,
# wrapping, import sort, and Tailwind class sort; it also reads indent_style,
# indent_size, and max_line_length from matching sections when those keys are
# unset in .oxfmtrc.json.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 80

# Tabs; width left to the reader (editorconfig.org). Matches oxfmt useTabs.
[*.{cjs,css,html,js,json,jsonc,jsx,mjs,svg,ts,tsx}]
indent_style = tab

# YAML 1.1/1.2: tabs are not legal indentation. GitHub Actions, pnpm workspace.
[*.{yml,yaml}]
indent_style = space
indent_size = 2
max_line_length = unset

# Generated; do not reindent on save.
[pnpm-lock.yaml]
indent_style = unset
indent_size = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
max_line_length = unset

[*.toml]
indent_style = space
indent_size = 2

# CommonMark list indent is two spaces; two trailing spaces is a hard line break.
[*.{md,mdx}]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
max_line_length = unset

# Recipe lines are tab-prefixed. just accepts tabs; Make requires them.
[{justfile,Justfile,Makefile,makefile,GNUmakefile,*.mk}]
indent_style = tab

[*.{diff,patch}]
trim_trailing_whitespace = false

[*.{gif,ico,jpg,jpeg,png,webp,woff,woff2}]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
max_line_length = unset
